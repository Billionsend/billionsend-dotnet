<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <RootNamespace>BillionSend</RootNamespace>
    <AssemblyName>BillionSend</AssemblyName>

    <PackageId>BillionSend</PackageId>
    <Version>0.2.2</Version>
    <Authors>BillionSend</Authors>
    <Company>BillionSend</Company>
    <Product>BillionSend</Product>
    <Copyright>Copyright (c) 2026 BillionSend</Copyright>
    <Description>The official .NET client for the BillionSend email API: send email, run inboxes for people and agents, stream inbox events, verify webhooks, and manage domains, contacts and broadcasts.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://billionsend.com/docs</PackageProjectUrl>
    <RepositoryUrl>https://github.com/billionsend/billionsend-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>billionsend;email;email-api;transactional-email;inbox;agents;webhooks;sdk</PackageTags>
    <PackageReleaseNotes>https://github.com/billionsend/billionsend-dotnet/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="BillionSend.Tests" />
    <InternalsVisibleTo Include="BillionSend.E2E" />
  </ItemGroup>

</Project>
