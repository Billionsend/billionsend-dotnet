<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runs the SDK against the live API. Not part of BillionSend.sln, so `dotnet test` at the root
    never builds or runs it; see "Live API tests" in the README.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="JsonSchema.Net" Version="9.4.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The OpenAPI reader, the schema check and the contract mock are the offline suite's. -->
    <Compile Include="../BillionSend.Tests/Support/Spec.cs" Link="Support/Spec.cs" />
    <Compile Include="../BillionSend.Tests/Support/ContractMock.cs" Link="Support/ContractMock.cs" />
    <ProjectReference Include="../../src/BillionSend/BillionSend.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="System.Text.Json.Nodes" />
  </ItemGroup>

</Project>
